<?xml version="1.0" encoding="UTF-8"?>
<AttendanceRegistry>
  <EmployeeRecord id="{{userId}}">
    <Username>{{username}}</Username>
    <RegistrationDate>{{registrationDate}}</RegistrationDate>
    <SecurityScheme>
      <Algorithm>AES-GCM-256</Algorithm>
      <IV>{{iv}}</IV>
    </SecurityScheme>
    <WebAuthnCredentialId>{{credentialId}}</WebAuthnCredentialId>
    <EncryptedPublicKey>{{encryptedPublicKey}}</EncryptedPublicKey>
  </EmployeeRecord>
</AttendanceRegistry>
